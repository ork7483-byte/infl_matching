generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Users & Auth
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role
  name          String?
  plan          Plan      @default(FREE)
  planStartedAt DateTime  @default(now())
  isEarlyAccess Boolean   @default(true)
  referralCode  String?   @unique
  referredBy    String?
  referralCount Int       @default(0)
  onboardingCompleted Boolean @default(false)
  location      String?
  gender        String?
  language      String?  @default("ko")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand         Brand?
  influencer    Influencer?
  sessions      Session[]
}

enum Role {
  BRAND
  CREATOR
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Brand
// ============================================

model Brand {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  industry    String?
  logoUrl     String?
  website     String?
  createdAt   DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
}

// ============================================
// Influencer
// ============================================

model Influencer {
  id                  String   @id @default(cuid())
  userId              String?  @unique
  igUserId            String?  @unique
  username            String   @unique
  fullName            String?
  biography           String?
  profilePicUrl       String?
  followersCount      Int      @default(0)
  followingCount      Int      @default(0)
  mediaCount          Int      @default(0)
  categories          String[]
  avgEngagementRate   Float?
  location            String?
  gender              String?
  language            String?  @default("ko")
  avgRating           Float?
  reviewCount         Int      @default(0)
  isTopCreator        Boolean  @default(false)
  isUgc               Boolean  @default(false)
  bestPostThumbnail   String?
  isOauthConnected    Boolean  @default(false)
  accessToken         String?
  lastSyncedAt        DateTime?
  source              String   @default("collected")
  collectedAt         DateTime?
  lastUpdatedAt       DateTime?
  isActive            Boolean  @default(true)
  rawData             Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                 User?     @relation(fields: [userId], references: [id])
  followerHistory      FollowerHistory[]
  mediaSnapshots       MediaSnapshot[]
  audienceDemographics AudienceDemographic[]
  aqsScores            AqsScore[]
  igrScores            IgrScore[]
  aiClone              AIClone?
  pricePredictions     PricePrediction[]
  campaignInfluencers  CampaignInfluencer[]
  campaignApplications CampaignApplication[]
  payments             Payment[]
  portfolioItems       PortfolioItem[]

  @@index([followersCount])
  @@index([avgEngagementRate])
  @@index([categories])
}

// ============================================
// Follower History (daily snapshots)
// ============================================

model FollowerHistory {
  id              String   @id @default(cuid())
  influencerId    String
  followersCount  Int
  followingCount  Int
  mediaCount      Int
  recordedDate    DateTime @db.Date

  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, recordedDate])
  @@index([influencerId, recordedDate])
}

// ============================================
// Media (Post) Snapshots
// ============================================

model MediaSnapshot {
  id              String   @id @default(cuid())
  influencerId    String
  igMediaId       String
  mediaType       MediaType
  caption         String?
  likeCount       Int      @default(0)
  commentsCount   Int      @default(0)
  reach           Int?
  impressions     Int?
  saved           Int?
  shares          Int?
  permalink       String?
  thumbnailUrl    String?
  postedAt        DateTime
  collectedAt     DateTime @default(now())

  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, postedAt])
}

enum MediaType {
  IMAGE
  VIDEO
  CAROUSEL_ALBUM
  REEL
  STORY
}

// ============================================
// Audience Demographics
// ============================================

model AudienceDemographic {
  id              String   @id @default(cuid())
  influencerId    String
  breakdownType   String
  breakdownKey    String
  value           Float
  collectedAt     DateTime @default(now())

  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, breakdownType])
}

// ============================================
// AQS Score
// ============================================

model AqsScore {
  id                      String   @id @default(cuid())
  influencerId            String
  totalScore              Float
  engagementAuthenticity  Float    // 참여진정성 (35%)
  audienceQuality         Float    // 오디언스품질 (30%)
  contentConsistency      Float    // 성과일관성 (20%)
  commentQuality          Float    // 댓글품질 (15%)
  // 하위 호환 (기존 5축 → 4축 전환, 이전 필드는 nullable)
  engagementQuality       Float?
  growthPattern           Float?
  ratioAnalysis           Float?
  commentAuthenticity     Float?
  signals                 Json
  grade                   String?
  label                   String?
  modelVersion            String?
  calculatedAt            DateTime @default(now())

  influencer              Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, calculatedAt])
}

// ============================================
// IGR Score (Instagram Grade Rating)
// ============================================

model IgrScore {
  id                String   @id @default(cuid())
  influencerId      String
  totalScore        Float
  reelsPerformance  Float
  engagementQuality Float
  contentStrategy   Float
  growthMomentum    Float
  grade             String
  label             String
  modelVersion      String?
  calculatedAt      DateTime @default(now())

  influencer        Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, calculatedAt])
}

// ============================================
// AI Predictions & Ad Pricing
// ============================================

model PricePrediction {
  id                      String   @id @default(cuid())
  influencerId            String
  predictedFeeMin         Float
  predictedFeeMax         Float
  predictedReach          Int
  predictedLikes          Int?
  predictedComments       Int?
  predictedEngagementRate Float?
  predictedCpr            Float?
  predictedCpe            Float?
  contentType             String?
  modelVersion            String?
  confidenceScore         Float?
  calculatedAt            DateTime @default(now())

  influencer              Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, calculatedAt])
}

// ============================================
// Campaign
// ============================================

model Campaign {
  id          String         @id @default(cuid())
  brandId     String
  name        String
  description String?
  hashtag     String?
  contentType String?
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  status      CampaignStatus @default(DRAFT)
  isPublic    Boolean        @default(false)
  category    String?
  rewardType  RewardType?
  rewardAmount Float?
  requirements String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignInfluencers  CampaignInfluencer[]
  campaignPosts        CampaignPost[]
  campaignApplications CampaignApplication[]

  @@index([status])
  @@index([isPublic, status])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RewardType {
  PAID
  PRODUCT
  MIXED
}

// ============================================
// Campaign-Influencer Relationship
// ============================================

model CampaignInfluencer {
  id            String                   @id @default(cuid())
  campaignId    String
  influencerId  String
  agreedFee     Float?
  status        CampaignInfluencerStatus @default(INVITED)
  invitedAt     DateTime                 @default(now())
  acceptedAt    DateTime?
  completedAt   DateTime?

  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer    Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payments      Payment[]

  @@unique([campaignId, influencerId])
}

enum CampaignInfluencerStatus {
  INVITED
  ACCEPTED
  CONTENT_SUBMITTED
  COMPLETED
  REJECTED
  CANCELLED
}

// ============================================
// Campaign Applications (Marketplace)
// ============================================

model CampaignApplication {
  id            String            @id @default(cuid())
  campaignId    String
  influencerId  String
  message       String?
  expectedReach Int?
  status        ApplicationStatus @default(PENDING)
  appliedAt     DateTime          @default(now())
  reviewedAt    DateTime?

  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencer    Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, influencerId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================
// Campaign Posts
// ============================================

model CampaignPost {
  id            String   @id @default(cuid())
  campaignId    String
  influencerId  String
  igMediaId     String?
  permalink     String?
  postedAt      DateTime?
  createdAt     DateTime @default(now())

  campaign              Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  performanceSnapshots  PostPerformanceSnapshot[]

  @@index([campaignId])
}

// ============================================
// Post Performance Snapshots (time-series)
// ============================================

model PostPerformanceSnapshot {
  id              String   @id @default(cuid())
  campaignPostId  String
  likeCount       Int      @default(0)
  commentsCount   Int      @default(0)
  reach           Int?
  impressions     Int?
  saved           Int?
  shares          Int?
  engagementRate  Float?
  snapshotAt      DateTime @default(now())

  campaignPost    CampaignPost @relation(fields: [campaignPostId], references: [id], onDelete: Cascade)

  @@index([campaignPostId, snapshotAt])
}

// ============================================
// Payments
// ============================================

model Payment {
  id                    String        @id @default(cuid())
  campaignInfluencerId  String
  influencerId          String
  amount                Float
  status                PaymentStatus @default(PENDING)
  requestedAt           DateTime      @default(now())
  processedAt           DateTime?
  note                  String?

  campaignInfluencer    CampaignInfluencer @relation(fields: [campaignInfluencerId], references: [id], onDelete: Cascade)
  influencer            Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ============================================
// Portfolio Items (Gallery)
// ============================================

model PortfolioItem {
  id              String    @id @default(cuid())
  influencerId    String
  igMediaId       String?
  mediaType       MediaType
  mediaUrl        String
  thumbnailUrl    String?
  caption         String?
  likeCount       Int       @default(0)
  commentsCount   Int       @default(0)
  reach           Int?
  impressions     Int?
  engagementRate  Float?
  campaignName    String?
  brandName       String?
  category        String?
  isFeatured      Boolean   @default(false)
  postedAt        DateTime?
  createdAt       DateTime  @default(now())

  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isFeatured])
  @@index([createdAt])
}

// ============================================
// Token Management
// ============================================

model ApiToken {
  id          String   @id @default(cuid())
  provider    String   @unique // "instagram", "facebook"
  accessToken String
  tokenType   String   @default("bearer")
  expiresAt   DateTime
  refreshedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

// ============================================
// Page Visits (UTM Tracking)
// ============================================

model PageVisit {
  id          String   @id @default(cuid())
  path        String
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  referrer    String?
  visitedAt   DateTime @default(now())

  @@index([path])
  @@index([utmSource])
  @@index([visitedAt])
}

// ============================================
// Event Log (Marketing Funnel Tracking)
// ============================================

model EventLog {
  id          String   @id @default(cuid())
  eventType   String   // page_view, signup_start, signup_complete, login, feature_use, search, profile_view, campaign_create
  userId      String?
  sessionId   String?
  path        String?
  metadata    Json?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
  @@index([utmSource])
}

// ============================================
// Share Actions (Viral)
// ============================================

model ShareAction {
  id          String   @id @default(cuid())
  userId      String
  shareType   String   // instagram_story, link_copy, referral
  shareUrl    String?
  verified    Boolean  @default(false)
  rewardGiven Boolean  @default(false)
  rewardType  String?  // premium_mediakit, premium_theme
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================
// Referrals (Invite System)
// ============================================

model Referral {
  id            String    @id @default(cuid())
  referrerId    String
  referredId    String?
  referralCode  String    @unique
  referralLink  String
  status        String    @default("pending") // pending, completed, rewarded
  rewardGiven   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([referrerId])
  @@index([referralCode])
}

// ============================================
// Reviews (Brand → Creator ratings)
// ============================================

model Review {
  id         String   @id @default(cuid())
  rating     Float
  comment    String?
  campaignId String
  brandId    String
  creatorId  String
  createdAt  DateTime @default(now())

  @@index([creatorId])
}

// ============================================
// Influencer CRM (Brand → Creator relationship)
// ============================================

model SavedInfluencer {
  id              String    @id @default(cuid())
  brandId         String
  influencerId    String
  status          String    @default("discovered")
  tags            String[]  @default([])
  notes           String?
  rating          Float?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([brandId, influencerId])
  @@index([brandId])
  @@index([status])
}

// ============================================
// Outreach Messages
// ============================================

model OutreachMessage {
  id            String    @id @default(cuid())
  brandId       String
  influencerId  String
  templateId    String?
  subject       String
  body          String
  status        String    @default("draft")
  sentAt        DateTime?
  openedAt      DateTime?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([brandId])
  @@index([influencerId])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  brandId   String?
  name      String
  subject   String
  body      String
  category  String
  createdAt DateTime @default(now())
}

// ============================================
// Ambassador Pages
// ============================================

model AmbassadorPage {
  id            String   @id @default(cuid())
  brandId       String
  slug          String   @unique
  title         String
  description   String
  requirements  String?
  benefits      String?
  headerImage   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  applications  AmbassadorApplication[]
}

model AmbassadorApplication {
  id                String   @id @default(cuid())
  pageId            String
  creatorId         String?
  instagramUsername  String
  name              String
  email             String
  message           String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  page              AmbassadorPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// ============================================
// AI Studio
// ============================================

model AIModel {
  id              String   @id @default(cuid())
  name            String
  nameEn          String
  gender          String
  ageGroup        String
  styles          String[]
  bodyType        String?
  ethnicity       String?
  profileImage    String
  portfolioImages String[]
  description     String?
  supportImage    Boolean  @default(true)
  supportVideo    Boolean  @default(false)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  generations     AIGeneration[]

  @@index([gender])
  @@index([ageGroup])
  @@index([isActive])
}

model AIGeneration {
  id               String   @id @default(cuid())
  userId           String
  modelId          String
  contentType      String
  productImage     String?
  settings         Json
  additionalPrompt String?
  resultImages     String[]
  creditsUsed      Int      @default(1)
  status           String   @default("pending")
  isSample         Boolean  @default(false)
  createdAt        DateTime @default(now())

  model            AIModel  @relation(fields: [modelId], references: [id])

  @@index([userId])
  @@index([modelId])
  @@index([status])
  @@index([isSample])
}

model CreditBalance {
  id              String   @id @default(cuid())
  userId          String   @unique
  monthlyCredits  Int      @default(3)
  bonusCredits    Int      @default(0)
  usedThisMonth   Int      @default(0)
  resetDate       DateTime
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model CreditPurchase {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  price       Int
  paymentId   String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ============================================
// Collection Seeds (자동 수집 시드)
// ============================================

model CollectionSeed {
  id             String    @id @default(cuid())
  username       String    @unique
  category       String?
  source         String
  discoveredFrom String?
  status         String    @default("pending")
  processedAt    DateTime?
  failCount      Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([category])
}

// ============================================
// Collection Logs (수집 작업 기록)
// ============================================

model CollectionLog {
  id            String   @id @default(cuid())
  jobDate       DateTime
  totalSeeds    Int
  successCount  Int
  failCount     Int
  newDiscovered Int
  apiCallsUsed  Int
  duration      Int
  createdAt     DateTime @default(now())
}

// ============================================
// Match Requests (중개 매칭)
// ============================================

model MatchRequest {
  id              String    @id @default(cuid())
  brandId         String
  influencerId    String
  campaignTitle   String
  campaignType    String
  budget          String?
  startDate       DateTime?
  endDate         DateTime?
  description     String
  status          String    @default("pending")
  adminNote       String?
  contactedAt     DateTime?
  respondedAt     DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([brandId])
  @@index([influencerId])
  @@index([status])
}

// ============================================
// AI Clone (AI 분신)
// ============================================

model AIClone {
  id              String   @id @default(cuid())
  influencerId    String   @unique
  influencer      Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status          String   @default("generating") // generating, ready, approved, active, disabled
  sourcePhotos    String[] // Instagram 게시물에서 선별된 사진 URLs
  portfolioImages String[] // 생성된 AI 포트폴리오
  styles          String[] // 자동 추출된 스타일 태그
  approvedAt      DateTime?
  totalEarnings   Float    @default(0)
  totalUsageCount Int      @default(0)
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revenues        CloneRevenue[]
  usageLogs       CloneUsageLog[]

  @@index([status])
  @@index([isPublic])
}

model CloneRevenue {
  id            String   @id @default(cuid())
  cloneId       String
  influencerId  String
  brandUserId   String
  generationId  String?  // AI 생성 ID
  totalAmount   Float    // 총 금액
  creatorShare  Float    // 인플루언서 몫 (60%)
  platformShare Float    // 플랫폼 몫 (40%)
  status        String   @default("pending") // pending, processing, completed
  createdAt     DateTime @default(now())

  clone         AIClone  @relation(fields: [cloneId], references: [id], onDelete: Cascade)

  @@index([cloneId])
  @@index([influencerId])
  @@index([status])
}

model CloneUsageLog {
  id          String   @id @default(cuid())
  cloneId     String
  brandUserId String
  contentType String   // product, lifestyle, fashion, beauty
  creditsUsed Int      @default(1)
  createdAt   DateTime @default(now())

  clone       AIClone  @relation(fields: [cloneId], references: [id], onDelete: Cascade)

  @@index([cloneId])
  @@index([brandUserId])
}
